[Unit]
Description=orderloom binance price poller
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/orderloom/price_poller
EnvironmentFile=/etc/orderloom/orderloom.env
ExecStart=/usr/local/bin/bun run src/index.ts

# Upstream Binance WS drops connections routinely; always come back.
Restart=always
RestartSec=5

MemoryMax=512M
SyslogIdentifier=orderloom-poller

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/orderloom/price_poller

[Install]
WantedBy=multi-user.target
