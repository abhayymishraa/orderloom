# Server copy: /etc/orderloom/orderloom.env, chown root:ubuntu, chmod 640 (see deploy/README.md).
# Never committed. `newdb.sh orderloom` prints DATABASE_URL for you.

# Trades + candles: local TimescaleDB. Big, disposable, needs the extension.
DATABASE_URL=postgresql://orderloom:CHANGEME@localhost:5432/orderloom_db
REDIS_URL=redis://localhost:6379/0

# Accounts + positions: Neon. Small, must outlive the box.
# Pooled endpoint for runtime — pgbouncer=true or a column type change breaks
# every query with "cached plan must not change result type".
# Quote these two: deploy.sh sources this file with `.`, and an unquoted `&`
# is a shell background operator, so the assignment silently never happens.
NEON_DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct (non-pooled) endpoint — migrations only.
NEON_DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

NODE_ENV=production

# Required — the app refuses to boot in production without it.
#   openssl rand -hex 32
JWT_SECRET=CHANGEME

# Comma-separated; a single-label wildcard is allowed for Vercel previews.
# Never a bare "*": credentials are on, so any site could act as a signed-in user.
CORS_ORIGINS=http://localhost:3000,https://orderloom.abhayymishraa.com,https://*.vercel.app

# Leave EMPTY: frontend and API are cross-site, a domain attr breaks login.
COOKIE_DOMAIN=
