[Unit]
Description=orderloom http api
After=postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/orderloom/http_server
EnvironmentFile=/etc/orderloom/orderloom.env
Environment=PORT=5000
ExecStart=/usr/local/bin/bun run src/index.ts

Restart=always
RestartSec=3

MemoryMax=1G
SyslogIdentifier=orderloom-http

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/orderloom/http_server

[Install]
WantedBy=multi-user.target
