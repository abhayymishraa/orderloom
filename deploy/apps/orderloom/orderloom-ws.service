[Unit]
Description=orderloom websocket fanout
After=redis-server.service
Requires=redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/orderloom/ws
EnvironmentFile=/etc/orderloom/orderloom.env
Environment=PORT=8080
ExecStart=/usr/local/bin/bun run index.ts

Restart=always
RestartSec=3

MemoryMax=512M
SyslogIdentifier=orderloom-ws

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/orderloom/ws

[Install]
WantedBy=multi-user.target
